# Anthropic credentials (optional, first match wins):
#   1. ANTHROPIC_API_KEY     - API key from https://console.anthropic.com/
#   2. ANTHROPIC_AUTH_TOKEN  - OAuth bearer token
#   3. `ant auth login` profile (~/.config/anthropic) - local dev only, not visible from Docker
# Without any of them the app still starts and the UI explains what is missing.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=

# Used when running the API outside Docker (make dev / pnpm dev). Docker Compose sets its own.
DATABASE_URL=postgres://meteo:meteo@localhost:5433/meteo
